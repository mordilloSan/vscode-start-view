{
	"name": "start-view",
	"publisher": "MiguelMariz",
	"version": "1.0.0",
	"displayName": "Start View",
	"description": "A Home button in the activity bar with configurable quick-access buttons for opening a project.",
	"icon": "icon.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mordilloSan/vscode-start-view.git"
	},
	"engines": {
		"vscode": "^1.74.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"extensionKind": [
		"ui"
	],
	"scripts": {
		"package": "vsce package"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "startView",
					"title": "Start",
					"icon": "$(home)"
				}
			]
		},
		"views": {
			"startView": [
				{
					"id": "startView.start",
					"name": "Start",
					"icon": "$(home)"
				}
			]
		},
		"viewsWelcome": [
			{
				"contents": "Local",
				"when": "config.startView.items.openFolder || config.startView.items.projectManager && startView.hasProjectManager",
				"view": "startView.start"
			},
			{
				"contents": "[Open Folder](command:workbench.action.files.openFolder)",
				"when": "config.startView.items.openFolder",
				"view": "startView.start"
			},
			{
				"contents": "[Project Manager](command:workbench.view.extension.project-manager)",
				"when": "config.startView.items.projectManager && startView.hasProjectManager",
				"view": "startView.start"
			},
			{
				"contents": "Repository",
				"when": "config.startView.items.cloneRepository || config.startView.items.openRemoteRepository && startView.hasRemoteHub",
				"view": "startView.start"
			},
			{
				"contents": "[Open Remote Repository](command:remoteHub.openRepository)",
				"when": "config.startView.items.openRemoteRepository && startView.hasRemoteHub",
				"view": "startView.start"
			},
			{
				"contents": "[Clone Repository](command:git.clone)",
				"when": "config.startView.items.cloneRepository",
				"view": "startView.start"
			},
			{
				"contents": "Remote",
				"when": "config.startView.items.remoteExplorer && startView.hasRemoteExplorer || config.startView.items.wslExplorer && startView.hasWslManager",
				"view": "startView.start"
			},
			{
				"contents": "[Remote Explorer](command:workbench.view.remote)",
				"when": "config.startView.items.remoteExplorer && startView.hasRemoteExplorer",
				"view": "startView.start"
			},
			{
				"contents": "[WSL Explorer](command:workbench.view.extension.wsl-manager)",
				"when": "config.startView.items.wslExplorer && startView.hasWslManager",
				"view": "startView.start"
			}
		],
		"configuration": {
			"title": "Start View",
			"properties": {
				"startView.openOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "Open the Start view when a window starts with no folder."
				},
				"startView.items.openFolder": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"Open Folder\" button in the Start view."
				},
				"startView.items.projectManager": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"Project Manager\" button in the Start view. Only appears when the Project Manager extension is installed."
				},
				"startView.items.openRemoteRepository": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"Open Remote Repository\" button in the Start view. Only appears when the GitHub Repositories extension is installed."
				},
				"startView.items.cloneRepository": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"Clone Repository\" button in the Start view."
				},
				"startView.items.remoteExplorer": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"Remote Explorer\" button in the Start view. Only appears when the Remote Explorer extension is installed."
				},
				"startView.items.wslExplorer": {
					"type": "boolean",
					"default": true,
					"description": "Show the \"WSL Explorer\" button in the Start view. Only appears when the WSL Manager extension is installed."
				}
			}
		}
	},
	"devDependencies": {
		"@vscode/vsce": "^4.1.0"
	},
	"overrides": {
		"minimatch": "^11.0.1"
	}
}
